# Hackathon Hub - Server Environment Configuration
# Copy this file to .env and adjust values as needed

# Server
PORT=5000
NODE_ENV=development

# Database
# Format: postgresql://[user[:password]@][host][:port][/dbname]
DATABASE_URL=postgresql://postgres@localhost:5432/hackathon_hub

# JWT Authentication
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=hackathon-hub-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173