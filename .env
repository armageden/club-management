# Hackathon Hub - Root Environment Configuration
# For docker-compose and shared settings
# Copy to .env and adjust as needed

# Database
POSTGRES_DB=hackathon_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Server
SERVER_PORT=5000
DATABASE_URL=postgresql://postgres:postgres@db:5432/hackathon_hub
JWT_SECRET=hackathon-hub-secret-key-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Client
CLIENT_PORT=5173
VITE_API_URL=http://localhost:5000/api/v1